APP_NAME="Africa Print Communication"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Pour PostgreSQL si souhaité :
